{
  "$defs": {
    "AnchorConfig": {
      "additionalProperties": false,
      "description": "External audit checkpoints (spec \u00a75.2, D49): used when audit_anchor = \"git\".",
      "properties": {
        "branch": {
          "default": "main",
          "pattern": "^[A-Za-z0-9._/-]{1,100}$",
          "title": "Branch",
          "type": "string"
        },
        "interval_minutes": {
          "default": 60,
          "maximum": 1440,
          "minimum": 5,
          "title": "Interval Minutes",
          "type": "integer"
        },
        "repo": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "a private git repo you own, e.g. git@github.com:you/anchors.git",
          "title": "Repo"
        },
        "tsa_ca_file": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "the authority's CA certificate (PEM), to verify timestamps",
          "title": "Tsa Ca File"
        },
        "tsa_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "opt-in RFC 3161 timestamp authority for checkpoints, e.g. https://freetsa.org/tsr (only the checkpoint's hash is sent)",
          "title": "Tsa Url"
        }
      },
      "title": "AnchorConfig",
      "type": "object"
    },
    "BackupConfig": {
      "additionalProperties": false,
      "description": "Encrypted backups with restic (spec \u00a74.8, FR-SYNC-1/3/8).",
      "properties": {
        "include_artifacts": {
          "default": true,
          "title": "Include Artifacts",
          "type": "boolean"
        },
        "include_config": {
          "default": true,
          "description": "the config folder (no secrets)",
          "title": "Include Config",
          "type": "boolean"
        },
        "include_research": {
          "default": true,
          "description": "research.db (indexed libraries)",
          "title": "Include Research",
          "type": "boolean"
        },
        "interval_hours": {
          "default": 24,
          "description": "auto mode: how often",
          "maximum": 720,
          "minimum": 1,
          "title": "Interval Hours",
          "type": "integer"
        },
        "keep_daily": {
          "default": 7,
          "maximum": 3650,
          "minimum": 0,
          "title": "Keep Daily",
          "type": "integer"
        },
        "keep_monthly": {
          "default": 12,
          "maximum": 1200,
          "minimum": 0,
          "title": "Keep Monthly",
          "type": "integer"
        },
        "keep_weekly": {
          "default": 4,
          "maximum": 520,
          "minimum": 0,
          "title": "Keep Weekly",
          "type": "integer"
        },
        "mode": {
          "default": "none",
          "description": "none: no backups; on_demand: `cairnward backup run`; auto: also by serve",
          "enum": [
            "none",
            "on_demand",
            "auto"
          ],
          "title": "Mode",
          "type": "string"
        },
        "password_command": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "command printing the repository password (e.g. `pass show cairnward`); default: a generated password in the state folder",
          "title": "Password Command"
        },
        "repository": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "a folder for the restic repository: a second disk, NAS mount or synced folder (contents are encrypted by restic)",
          "title": "Repository"
        }
      },
      "title": "BackupConfig",
      "type": "object"
    },
    "CustomPattern": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "default": "personal",
          "enum": [
            "secret",
            "personal"
          ],
          "title": "Category",
          "type": "string"
        },
        "name": {
          "pattern": "^[a-z0-9_]{1,40}$",
          "title": "Name",
          "type": "string"
        },
        "regex": {
          "title": "Regex",
          "type": "string"
        }
      },
      "required": [
        "name",
        "regex"
      ],
      "title": "CustomPattern",
      "type": "object"
    },
    "Defaults": {
      "additionalProperties": false,
      "properties": {
        "effort": {
          "default": "medium",
          "title": "Effort",
          "type": "string"
        },
        "environment": {
          "default": "coding",
          "title": "Environment",
          "type": "string"
        }
      },
      "title": "Defaults",
      "type": "object"
    },
    "EgressConfig": {
      "additionalProperties": false,
      "properties": {
        "approval_timeout_s": {
          "default": 120,
          "description": "an unanswered approval becomes a deny",
          "maximum": 3600,
          "minimum": 1,
          "title": "Approval Timeout S",
          "type": "integer"
        },
        "connect_timeout_s": {
          "default": 15,
          "maximum": 300,
          "minimum": 1,
          "title": "Connect Timeout S",
          "type": "integer"
        },
        "idle_timeout_s": {
          "default": 300,
          "maximum": 86400,
          "minimum": 5,
          "title": "Idle Timeout S",
          "type": "integer"
        },
        "max_connections": {
          "default": 64,
          "maximum": 4096,
          "minimum": 1,
          "title": "Max Connections",
          "type": "integer"
        }
      },
      "title": "EgressConfig",
      "type": "object"
    },
    "PrivacyOverrides": {
      "additionalProperties": false,
      "description": "A `[privacy]` table: an optional preset plus optional individual settings.",
      "properties": {
        "approvals": {
          "anyOf": [
            {
              "enum": [
                "off",
                "high_only",
                "tiered"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Approvals"
        },
        "audit": {
          "anyOf": [
            {
              "enum": [
                "on",
                "off"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Audit"
        },
        "audit_anchor": {
          "anyOf": [
            {
              "enum": [
                "off",
                "git"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Audit Anchor"
        },
        "backup_purge": {
          "anyOf": [
            {
              "enum": [
                "off",
                "ask",
                "on"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Backup Purge"
        },
        "crypto_shred": {
          "anyOf": [
            {
              "enum": [
                "on",
                "off"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Crypto Shred"
        },
        "egress_report": {
          "anyOf": [
            {
              "enum": [
                "on",
                "off"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Egress Report"
        },
        "hosted_backends": {
          "anyOf": [
            {
              "enum": [
                "allow",
                "ask",
                "deny"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hosted Backends"
        },
        "isolation": {
          "anyOf": [
            {
              "enum": [
                "on",
                "off"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Isolation"
        },
        "mcp_pinning": {
          "anyOf": [
            {
              "enum": [
                "on",
                "off"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mcp Pinning"
        },
        "network": {
          "anyOf": [
            {
              "enum": [
                "open",
                "ask",
                "allowlist",
                "off"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Network"
        },
        "network_allow_hosts": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "hosts allowed when network = 'allowlist' or pre-approved in 'ask'",
          "title": "Network Allow Hosts"
        },
        "preset": {
          "anyOf": [
            {
              "enum": [
                "open",
                "balanced",
                "strict"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "open, balanced or strict",
          "title": "Preset"
        },
        "redaction": {
          "anyOf": [
            {
              "enum": [
                "off",
                "warn",
                "enforce"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Redaction"
        },
        "training_backends": {
          "anyOf": [
            {
              "enum": [
                "allow",
                "scratch_only"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Training Backends"
        },
        "vault": {
          "anyOf": [
            {
              "enum": [
                "off",
                "digests",
                "full"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vault"
        }
      },
      "title": "PrivacyOverrides",
      "type": "object"
    },
    "RedactionConfig": {
      "additionalProperties": false,
      "description": "What the redaction scanner looks for, besides its built-in patterns (spec \u00a75.4).",
      "properties": {
        "custom": {
          "items": {
            "$ref": "#/$defs/CustomPattern"
          },
          "title": "Custom",
          "type": "array"
        },
        "ignore": {
          "description": "regular expressions for matches to ignore (e.g. your own public email)",
          "items": {
            "type": "string"
          },
          "title": "Ignore",
          "type": "array"
        },
        "presidio": {
          "default": false,
          "description": "also use Presidio (optional engine: cairnward redaction install presidio) for names, places and groups",
          "title": "Presidio",
          "type": "boolean"
        },
        "presidio_entities": {
          "description": "Presidio entity types to report (patterns already cover emails, phones, cards and IBANs)",
          "items": {
            "type": "string"
          },
          "title": "Presidio Entities",
          "type": "array"
        },
        "presidio_min_score": {
          "default": 0.6,
          "maximum": 1,
          "minimum": 0,
          "title": "Presidio Min Score",
          "type": "number"
        }
      },
      "title": "RedactionConfig",
      "type": "object"
    },
    "ResearchConfig": {
      "additionalProperties": false,
      "description": "Research workflows (spec \u00a74.6).",
      "properties": {
        "citation_engine": {
          "default": "auto",
          "description": "reference formatting: auto = citeproc-js if installed, else pandoc, else the built-in APA/IEEE formatter",
          "enum": [
            "auto",
            "builtin",
            "citeproc-js",
            "pandoc"
          ],
          "title": "Citation Engine",
          "type": "string"
        },
        "grobid_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "your GROBID service on this machine, e.g. http://127.0.0.1:8070 (libraries with --metadata grobid)",
          "title": "Grobid Url"
        }
      },
      "title": "ResearchConfig",
      "type": "object"
    },
    "ServerConfig": {
      "additionalProperties": false,
      "properties": {
        "dashboard_host": {
          "default": "127.0.0.1",
          "description": "loopback only",
          "title": "Dashboard Host",
          "type": "string"
        },
        "dashboard_port": {
          "default": 8485,
          "maximum": 65535,
          "minimum": 1,
          "title": "Dashboard Port",
          "type": "integer"
        },
        "egress_port": {
          "default": 8486,
          "description": "cairnward-egress proxy",
          "maximum": 65535,
          "minimum": 1,
          "title": "Egress Port",
          "type": "integer"
        },
        "gateway_host": {
          "default": "127.0.0.1",
          "description": "loopback only",
          "title": "Gateway Host",
          "type": "string"
        },
        "gateway_port": {
          "default": 8484,
          "maximum": 65535,
          "minimum": 1,
          "title": "Gateway Port",
          "type": "integer"
        },
        "socket_path": {
          "anyOf": [
            {
              "format": "path",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Unix socket for the CLI (default: <state_dir>/cairnward.sock)",
          "title": "Socket Path"
        }
      },
      "title": "ServerConfig",
      "type": "object"
    },
    "TelemetryConfig": {
      "additionalProperties": false,
      "description": "OpenTelemetry export of model and tool calls (FR-AUD-5): off unless an endpoint is set.",
      "properties": {
        "interval_s": {
          "default": 30,
          "maximum": 3600,
          "minimum": 5,
          "title": "Interval S",
          "type": "integer"
        },
        "otlp_endpoint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "an OTLP/HTTP collector on this machine, e.g. http://127.0.0.1:4318 (Langfuse, Phoenix, Jaeger); no prompts or answers are sent",
          "title": "Otlp Endpoint"
        }
      },
      "title": "TelemetryConfig",
      "type": "object"
    }
  },
  "$id": "https://github.com/c23075/cairnward/schemas/cairnward.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "cairnward.toml",
  "properties": {
    "anchor": {
      "$ref": "#/$defs/AnchorConfig",
      "default": {
        "branch": "main",
        "interval_minutes": 60,
        "repo": null,
        "tsa_ca_file": null,
        "tsa_url": null
      }
    },
    "backup": {
      "$ref": "#/$defs/BackupConfig",
      "default": {
        "include_artifacts": true,
        "include_config": true,
        "include_research": true,
        "interval_hours": 24,
        "keep_daily": 7,
        "keep_monthly": 12,
        "keep_weekly": 4,
        "mode": "none",
        "password_command": null,
        "repository": null
      }
    },
    "defaults": {
      "$ref": "#/$defs/Defaults",
      "default": {
        "effort": "medium",
        "environment": "coding"
      }
    },
    "egress": {
      "$ref": "#/$defs/EgressConfig",
      "default": {
        "approval_timeout_s": 120,
        "connect_timeout_s": 15,
        "idle_timeout_s": 300,
        "max_connections": 64
      }
    },
    "privacy": {
      "$ref": "#/$defs/PrivacyOverrides",
      "default": {
        "approvals": null,
        "audit": null,
        "audit_anchor": null,
        "backup_purge": null,
        "crypto_shred": null,
        "egress_report": null,
        "hosted_backends": null,
        "isolation": null,
        "mcp_pinning": null,
        "network": null,
        "network_allow_hosts": null,
        "preset": null,
        "redaction": null,
        "training_backends": null,
        "vault": null
      }
    },
    "redaction": {
      "$ref": "#/$defs/RedactionConfig",
      "default": {
        "custom": [],
        "ignore": [],
        "presidio": false,
        "presidio_entities": [
          "PERSON",
          "LOCATION",
          "NRP"
        ],
        "presidio_min_score": 0.6
      }
    },
    "research": {
      "$ref": "#/$defs/ResearchConfig",
      "default": {
        "citation_engine": "auto",
        "grobid_url": null
      }
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "server": {
      "$ref": "#/$defs/ServerConfig",
      "default": {
        "dashboard_host": "127.0.0.1",
        "dashboard_port": 8485,
        "egress_port": 8486,
        "gateway_host": "127.0.0.1",
        "gateway_port": 8484,
        "socket_path": null
      }
    },
    "telemetry": {
      "$ref": "#/$defs/TelemetryConfig",
      "default": {
        "interval_s": 30,
        "otlp_endpoint": null
      }
    }
  },
  "title": "MainConfig",
  "type": "object"
}
