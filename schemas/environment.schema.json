{
  "$defs": {
    "HttpRule": {
      "additionalProperties": false,
      "description": "One method/path rule for inspected traffic (FR-NET-2). The first matching rule wins.",
      "properties": {
        "decision": {
          "enum": [
            "allow",
            "deny"
          ],
          "title": "Decision",
          "type": "string"
        },
        "host": {
          "description": "host pattern, as in network_allow_hosts ('*.example.org')",
          "title": "Host",
          "type": "string"
        },
        "method": {
          "default": "*",
          "description": "HTTP method, or '*' for any",
          "title": "Method",
          "type": "string"
        },
        "path": {
          "default": "/**",
          "description": "path glob: '*' within a segment, '**' across",
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "host",
        "decision"
      ],
      "title": "HttpRule",
      "type": "object"
    },
    "OpenShellOptions": {
      "additionalProperties": false,
      "description": "How `cairnward run` uses OpenShell when sandbox = 'openshell' (ADR-0018).",
      "properties": {
        "gateway": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "openshell gateway name (-g)",
          "title": "Gateway"
        },
        "host_name": {
          "default": "host.openshell.internal",
          "description": "the name a sandbox uses for this machine",
          "title": "Host Name",
          "type": "string"
        },
        "image": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "image the agent runs in (--from); default: the gateway's",
          "title": "Image"
        },
        "workdir": {
          "default": "/sandbox/work",
          "description": "where the workspace is copied",
          "title": "Workdir",
          "type": "string"
        }
      },
      "title": "OpenShellOptions",
      "type": "object"
    },
    "PrivacyOverrides": {
      "additionalProperties": false,
      "description": "A `[privacy]` table: an optional preset plus optional individual settings.",
      "properties": {
        "approvals": {
          "anyOf": [
            {
              "enum": [
                "off",
                "high_only",
                "tiered"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Approvals"
        },
        "audit": {
          "anyOf": [
            {
              "enum": [
                "on",
                "off"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Audit"
        },
        "audit_anchor": {
          "anyOf": [
            {
              "enum": [
                "off",
                "git"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Audit Anchor"
        },
        "backup_purge": {
          "anyOf": [
            {
              "enum": [
                "off",
                "ask",
                "on"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Backup Purge"
        },
        "crypto_shred": {
          "anyOf": [
            {
              "enum": [
                "on",
                "off"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Crypto Shred"
        },
        "egress_report": {
          "anyOf": [
            {
              "enum": [
                "on",
                "off"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Egress Report"
        },
        "home_access": {
          "anyOf": [
            {
              "enum": [
                "readable",
                "hidden"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Home Access"
        },
        "hosted_backends": {
          "anyOf": [
            {
              "enum": [
                "allow",
                "ask",
                "deny"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hosted Backends"
        },
        "isolation": {
          "anyOf": [
            {
              "enum": [
                "on",
                "off"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Isolation"
        },
        "mcp_pinning": {
          "anyOf": [
            {
              "enum": [
                "on",
                "off"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mcp Pinning"
        },
        "network": {
          "anyOf": [
            {
              "enum": [
                "open",
                "ask",
                "allowlist",
                "off"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Network"
        },
        "network_allow_hosts": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "hosts allowed when network = 'allowlist' or pre-approved in 'ask'",
          "title": "Network Allow Hosts"
        },
        "preset": {
          "anyOf": [
            {
              "enum": [
                "open",
                "balanced",
                "strict"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "open, balanced or strict",
          "title": "Preset"
        },
        "redaction": {
          "anyOf": [
            {
              "enum": [
                "off",
                "warn",
                "enforce"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Redaction"
        },
        "training_backends": {
          "anyOf": [
            {
              "enum": [
                "allow",
                "scratch_only"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Training Backends"
        },
        "vault": {
          "anyOf": [
            {
              "enum": [
                "off",
                "digests",
                "full"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vault"
        }
      },
      "title": "PrivacyOverrides",
      "type": "object"
    },
    "RunBudget": {
      "additionalProperties": false,
      "description": "Limits for one `cairnward run` (FR-GW-4); unset = unlimited.",
      "properties": {
        "max_minutes": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Minutes"
        },
        "max_requests": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Requests"
        },
        "max_tokens": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Tokens"
        }
      },
      "title": "RunBudget",
      "type": "object"
    },
    "TlsInspection": {
      "additionalProperties": false,
      "description": "Decrypting third-party HTTPS in cairnward-egress (FR-NET-2, ADR-0018). Off by default and\nnever set by a preset: tools in this environment must trust Cairnward's local CA, and\nCairnward then sees their requests.",
      "properties": {
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "rules": {
          "items": {
            "$ref": "#/$defs/HttpRule"
          },
          "title": "Rules",
          "type": "array"
        },
        "skip_hosts": {
          "description": "hosts tunnelled without inspection (clients that pin certificates)",
          "items": {
            "type": "string"
          },
          "title": "Skip Hosts",
          "type": "array"
        },
        "unmatched": {
          "default": "allow",
          "description": "requests no rule matches (the host itself is allowed)",
          "enum": [
            "allow",
            "deny"
          ],
          "title": "Unmatched",
          "type": "string"
        }
      },
      "title": "TlsInspection",
      "type": "object"
    }
  },
  "$id": "https://github.com/c23075/cairnward/schemas/environment.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "backend": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "override the backend for all roles",
      "title": "Backend"
    },
    "context_overflow": {
      "default": "warn",
      "description": "a prompt larger than context_tokens: warn, or refuse it",
      "enum": [
        "warn",
        "reject"
      ],
      "title": "Context Overflow",
      "type": "string"
    },
    "context_tokens": {
      "default": 8192,
      "description": "spec D60",
      "maximum": 1048576,
      "minimum": 512,
      "title": "Context Tokens",
      "type": "integer"
    },
    "description": {
      "default": "",
      "title": "Description",
      "type": "string"
    },
    "effort_default": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Effort Default"
    },
    "mcp_servers": {
      "description": "MCP servers (mcp.toml) offered in this environment",
      "items": {
        "type": "string"
      },
      "title": "Mcp Servers",
      "type": "array"
    },
    "models": {
      "additionalProperties": {
        "type": "string"
      },
      "propertyNames": {
        "enum": [
          "main",
          "fast",
          "vision",
          "embed"
        ]
      },
      "title": "Models",
      "type": "object"
    },
    "openshell": {
      "$ref": "#/$defs/OpenShellOptions",
      "default": {
        "gateway": null,
        "host_name": "host.openshell.internal",
        "image": null,
        "workdir": "/sandbox/work"
      }
    },
    "privacy": {
      "$ref": "#/$defs/PrivacyOverrides",
      "default": {
        "approvals": null,
        "audit": null,
        "audit_anchor": null,
        "backup_purge": null,
        "crypto_shred": null,
        "egress_report": null,
        "home_access": null,
        "hosted_backends": null,
        "isolation": null,
        "mcp_pinning": null,
        "network": null,
        "network_allow_hosts": null,
        "preset": null,
        "redaction": null,
        "training_backends": null,
        "vault": null
      }
    },
    "run_budget": {
      "$ref": "#/$defs/RunBudget",
      "default": {
        "max_minutes": null,
        "max_requests": null,
        "max_tokens": null
      }
    },
    "sandbox": {
      "default": "srt",
      "description": "the sandbox `cairnward run` uses when isolation = on: srt or openshell",
      "enum": [
        "srt",
        "openshell"
      ],
      "title": "Sandbox",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "scratch": {
      "default": false,
      "description": "throwaway work: backends that may train on prompts are allowed here (training_backends = scratch_only)",
      "title": "Scratch",
      "type": "boolean"
    },
    "skills": {
      "items": {
        "type": "string"
      },
      "title": "Skills",
      "type": "array"
    },
    "tls_inspection": {
      "$ref": "#/$defs/TlsInspection",
      "default": {
        "enabled": false,
        "rules": [],
        "skip_hosts": [],
        "unmatched": "allow"
      }
    },
    "tools": {
      "items": {
        "type": "string"
      },
      "title": "Tools",
      "type": "array"
    },
    "vault_retention_days": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Vault Retention Days"
    },
    "workspace": {
      "description": "folders agents may write",
      "items": {
        "format": "path",
        "type": "string"
      },
      "title": "Workspace",
      "type": "array"
    }
  },
  "title": "EnvironmentConfig",
  "type": "object"
}
