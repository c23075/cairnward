{
  "$defs": {
    "Backend": {
      "additionalProperties": false,
      "properties": {
        "api_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "a reference, never the key itself: 'keyring:<name>' or 'env:<VAR>'",
          "title": "Api Key"
        },
        "driver": {
          "enum": [
            "ollama",
            "openai_compat"
          ],
          "title": "Driver",
          "type": "string"
        },
        "fallback": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "a LOCAL backend to retry on when this one is unreachable or fails (5xx)",
          "title": "Fallback"
        },
        "fallback_model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "model name on the fallback backend (default: the same)",
          "title": "Fallback Model"
        },
        "location": {
          "default": "local",
          "enum": [
            "local",
            "lan",
            "hosted"
          ],
          "title": "Location",
          "type": "string"
        },
        "max_parallel": {
          "default": 1,
          "maximum": 64,
          "minimum": 1,
          "title": "Max Parallel",
          "type": "integer"
        },
        "slot_cache": {
          "default": false,
          "description": "llama.cpp only: save/restore each conversation's KV cache when switching conversations (start llama-server with --slot-save-path; needs max_parallel = 1)",
          "title": "Slot Cache",
          "type": "boolean"
        },
        "timeout_s": {
          "default": 900,
          "minimum": 1,
          "title": "Timeout S",
          "type": "integer"
        },
        "trains_on_prompts": {
          "default": false,
          "description": "the provider may use prompts to train or improve models (most free tiers): allowed only in scratch environments unless training_backends = allow",
          "title": "Trains On Prompts",
          "type": "boolean"
        },
        "url": {
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "driver",
        "url"
      ],
      "title": "Backend",
      "type": "object"
    },
    "RoleModel": {
      "additionalProperties": false,
      "properties": {
        "backend": {
          "title": "Backend",
          "type": "string"
        },
        "model": {
          "title": "Model",
          "type": "string"
        }
      },
      "required": [
        "backend",
        "model"
      ],
      "title": "RoleModel",
      "type": "object"
    }
  },
  "$id": "https://github.com/c23075/cairnward/schemas/backends.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "backends.toml",
  "properties": {
    "backends": {
      "additionalProperties": {
        "$ref": "#/$defs/Backend"
      },
      "title": "Backends",
      "type": "object"
    },
    "fallback": {
      "description": "local backends to try if a backend is down",
      "items": {
        "type": "string"
      },
      "title": "Fallback",
      "type": "array"
    },
    "roles": {
      "additionalProperties": {
        "$ref": "#/$defs/RoleModel"
      },
      "propertyNames": {
        "enum": [
          "main",
          "fast",
          "vision",
          "embed"
        ]
      },
      "title": "Roles",
      "type": "object"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "title": "BackendsConfig",
  "type": "object"
}
