# Pin images to versions you reviewed (a tag, or better a digest: image@sha256:...).
OPEN_WEBUI_IMAGE=ghcr.io/open-webui/open-webui:<version>
SOCAT_IMAGE=alpine/socat:<version>

# A key for this client: cairnward client add open-webui
CAIRNWARD_KEY=cw-...

# The folder holding Cairnward's client socket: <state folder>/clients
# (cairnward config paths shows the state folder; usually ~/.local/state/cairnward)
CAIRNWARD_CLIENT_SOCKETS=/home/<you>/.local/state/cairnward/clients

# Optional
# CAIRNWARD_EMBED_MODEL=cw/chat:embed
# OPEN_WEBUI_PORT=3000
